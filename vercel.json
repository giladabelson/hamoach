{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/oauth?op=resource-metadata" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?op=resource-metadata" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/oauth?op=server-metadata" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?op=server-metadata" },
    { "source": "/register", "destination": "/api/oauth?op=register" },
    { "source": "/authorize", "destination": "/api/oauth?op=authorize" },
    { "source": "/token", "destination": "/api/oauth?op=token" }
  ]
}
